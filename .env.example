# Provider configuration. Supply password credentials OR API tokens.
KINTONE_BASE_URL=https://example.cybozu.com
KINTONE_USERNAME=
KINTONE_PASSWORD=
KINTONE_API_TOKENS=

# Dedicated development credentials. Acceptance tests never use the generic values.
KINTONE_DEV_BASE_URL=
KINTONE_DEV_USERNAME=
KINTONE_DEV_PASSWORD=
# Existing, published dedicated app in KINTONE_DEV_BASE_URL, reused read-only.
KINTONE_DEV_TOKEN_APP_ID=
# Comma-separated tokens for that app; never put tokens in HCL or logs.
KINTONE_DEV_API_TOKENS=
# Enable only for an explicitly approved development acceptance-test run.
KINTONE_DEV_ALLOW_ACCEPTANCE_TESTS=0
